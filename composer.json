{
    "name": "g8scope/core",
    "version": "0.1.0",
    "description": "Domain layer for g8scope — enums, dual-ID trait, and driver contracts shared by the web app and MCP delegated writes.",
    "keywords": [
        "laravel",
        "g8scope",
        "error-tracking",
        "observability"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "cleaniquecoders/pii-protection": "^1.3",
        "cleaniquecoders/traitify": "^1.4",
        "g8scope/contracts": "^1.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "owen-it/laravel-auditing": "^14.0",
        "smi2/phpclickhouse": "^1.5"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "G8Scope\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "G8Scope\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "G8Scope\\Core\\G8ScopeCoreServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../g8scope-contracts",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
