{
    "name": "g8scope/core",
    "description": "Domain layer for g8scope — enums, dual-ID trait, and driver contracts shared by the web app and MCP delegated writes.",
    "keywords": ["laravel", "g8scope", "error-tracking", "observability"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "G8scope\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "G8scope\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "G8scope\\Core\\G8scopeCoreServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
